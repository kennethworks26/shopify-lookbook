# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
#
#   cp .env.example .env
#
# Nothing in this file may hold a real value. It documents shape only.

# --- Store binding ----------------------------------------------------------
# Development store domain, e.g. my-store.myshopify.com
SHOPIFY_STORE=

# Pinned explicitly. Never call an unversioned endpoint — Shopify versions
# quarterly as YYYY-MM and an unversioned call silently changes shape under you.
SHOPIFY_API_VERSION=2026-07

# --- Admin API --------------------------------------------------------------
# Used ONLY by scripts/setup/*, which run on your machine. This token is secret.
#
# BOUNDARY: an Admin token must never appear in theme Liquid, theme JavaScript,
# theme settings, or any committed file. It can read and write the whole store.
#
# Source: Settings → Apps and sales channels → Develop apps → your app
#         → API credentials → Admin API access token (revealed once)
#
# Scopes this project needs, and why:
#   read/write_products                 seed the catalog
#   read/write_metaobject_definitions   create the lookbook schema
#   read/write_metaobjects              create lookbook entries
#   read/write_markets                  AU + JP markets, catalogs, price lists
#   read/write_publications             publish products to the Online Store
#   read/write_inventory                stock, so products are purchasable
#   read_themes                         verification only
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# --- Storefront API ---------------------------------------------------------
# Public by design. The theme sends this from the browser, so it is visible to
# anyone viewing source — that is expected. It grants only
# `unauthenticated_read_product_listings`: read access to published products,
# the same data any visitor can already see.
#
# This value also goes into the theme's own settings (Online Store → Themes →
# Customize → Theme settings → Storefront API). It lives here so the setup
# scripts can verify it works before you paste it in.
SHOPIFY_STOREFRONT_API_ACCESS_TOKEN=

# --- Local development and end-to-end tests --------------------------------
# Storefront password. Development stores are always password protected and the
# protection cannot be disabled, so `npm run dev` and `npm run test:e2e` both
# need this. Online Store -> Preferences -> Password protection.
SHOPIFY_STORE_PASSWORD=

# Full storefront URL, used by the end-to-end tests. Without it they skip.
SHOPIFY_STORE_URL=
