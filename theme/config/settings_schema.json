[
  {
    "name": "theme_info",
    "theme_name": "Lookbook",
    "theme_version": "1.0.0",
    "theme_author": "John Kenneth Fernandez",
    "theme_documentation_url": "https://github.com/jkfernandez/shopify-lookbook",
    "theme_support_url": "https://github.com/jkfernandez/shopify-lookbook/issues"
  },
  {
    "name": "t:settings_schema.storefront_api.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings_schema.storefront_api.info"
      },
      {
        "type": "text",
        "id": "storefront_api_token",
        "label": "t:settings_schema.storefront_api.token.label",
        "info": "t:settings_schema.storefront_api.token.info"
      },
      {
        "type": "text",
        "id": "storefront_api_version",
        "default": "2026-07",
        "label": "t:settings_schema.storefront_api.version.label",
        "info": "t:settings_schema.storefront_api.version.info"
      }
    ]
  },
  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "font_picker",
        "id": "body_font",
        "default": "assistant_n4",
        "label": "t:settings_schema.typography.body_font.label"
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "default": "assistant_n6",
        "label": "t:settings_schema.typography.heading_font.label"
      }
    ]
  },
  {
    "name": "t:settings_schema.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 100,
        "unit": "px",
        "default": 1400,
        "label": "t:settings_schema.layout.page_width.label"
      }
    ]
  }
]
