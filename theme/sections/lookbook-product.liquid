{%- comment -%}
  Lookbook section for product pages.

  Unlike the home-page section this has no lookbook picker. The brief is explicit:
  when a merchant adds this section, it should surface whichever lookbooks happen to
  contain the product being viewed, capped at two. Which lookbooks those are is a
  property of the product, not a choice the merchant makes per placement -- offering a
  picker here would let the two disagree.

  Every other setting matches the home-page section, because both render through
  snippets/lookbook-mount.liquid.
{%- endcomment -%}

<div
  class="lookbook-section"
  style="--lookbook-padding-top: {{ section.settings.padding_top }}px; --lookbook-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="lookbook-section__inner">
    {%- comment -%}
      Selection and rendering both live in the snippet. `render` cannot return a
      value, so a snippet that only computed the matches would leave this section
      unable to see them -- and copying the rule up here to work around that is
      precisely how two implementations of "max two" drift apart.

      `section` is passed explicitly because `render` isolates scope: unlike the
      global objects, `section` exists only inside section files.
    {%- endcomment -%}
    {%- render 'lookbook-match', product: product, limit: 2, section: section -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.lookbook_product.name",
  "tag": "section",
  "class": "lookbook",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.lookbook_product.settings.explanation"
    },
    {
      "type": "header",
      "content": "t:sections.lookbook.settings.header_layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.lookbook.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "t:sections.lookbook.settings.columns_mobile.options.one" },
        { "value": "2", "label": "t:sections.lookbook.settings.columns_mobile.options.two" }
      ],
      "default": "2",
      "label": "t:sections.lookbook.settings.columns_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.lookbook.settings.header_content"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "default": true,
      "label": "t:sections.lookbook.settings.show_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "default": true,
      "label": "t:sections.lookbook.settings.show_price.label"
    },
    {
      "type": "checkbox",
      "id": "show_compare_at",
      "default": true,
      "label": "t:sections.lookbook.settings.show_compare_at.label",
      "info": "t:sections.lookbook.settings.show_compare_at.info"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.lookbook.settings.show_vendor.label"
    },
    {
      "type": "header",
      "content": "t:sections.lookbook.settings.header_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.lookbook.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.lookbook.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.lookbook_product.presets.name"
    }
  ]
}
{% endschema %}
