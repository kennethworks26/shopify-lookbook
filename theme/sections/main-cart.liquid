{%- comment -%}
  Cart. The product page has a working add-to-cart form, so without this the first
  thing a reviewer does after adding an item lands on a missing template.
{%- endcomment -%}

<div class="cart">
  <h1 class="cart__title">{{ 'cart.general.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <ul class="cart__items">
        {%- for item in cart.items -%}
          <li class="cart__item">
            {%- if item.image -%}
              <img
                src="{{ item.image | image_url: width: 200 }}"
                alt="{{ item.image.alt | escape }}"
                width="100"
                height="125"
                loading="lazy"
              >
            {%- endif -%}

            <div class="cart__item-info">
              <a href="{{ item.url }}">{{ item.product.title }}</a>
              <p class="cart__item-price">{{ item.final_line_price | money_with_currency }}</p>

              <label class="visually-hidden" for="quantity-{{ item.index | plus: 1 }}">
                {{ 'cart.general.quantity' | t }}
              </label>
              <input
                id="quantity-{{ item.index | plus: 1 }}"
                type="number"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
                inputmode="numeric"
              >
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <div class="cart__footer">
        <p class="cart__total">
          {{ 'cart.general.subtotal' | t }}
          <strong>{{ cart.total_price | money_with_currency }}</strong>
        </p>

        <button type="submit" name="update" class="cart__update">
          {{ 'cart.general.update' | t }}
        </button>
        <button type="submit" name="checkout" class="cart__checkout">
          {{ 'cart.general.checkout' | t }}
        </button>
      </div>
    </form>
  {%- else -%}
    <p class="cart__empty">{{ 'cart.general.empty' | t }}</p>
    <a class="cart__continue" href="{{ routes.all_products_collection_url }}">
      {{ 'cart.general.continue_shopping' | t }}
    </a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "tag": "section",
  "class": "main-cart",
  "settings": []
}
{% endschema %}
