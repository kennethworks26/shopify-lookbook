{%- comment -%}
  Blog listing. Exists so a merchant who creates a blog gets a working page
  rather than a missing-template error, and so /blogs/* is not a dead route.
{%- endcomment -%}

<div class="blog">
  <header class="blog__header">
    <h1 class="blog__title">{{ blog.title }}</h1>
  </header>

  {%- paginate blog.articles by 12 -%}
    {%- if blog.articles.size > 0 -%}
      <ul class="blog__list">
        {%- for article in blog.articles -%}
          <li class="blog__item">
            <a href="{{ article.url }}" class="blog__item-link">
              {%- if article.image -%}
                <img
                  src="{{ article.image | image_url: width: 700 }}"
                  alt="{{ article.image.alt | escape }}"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                  loading="lazy"
                >
              {%- endif -%}

              <h2 class="blog__item-title">{{ article.title }}</h2>
            </a>

            <p class="blog__item-meta">
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                {{ article.published_at | date: format: 'date' }}
              </time>
            </p>

            {%- if article.excerpt_or_content != blank -%}
              <p class="blog__item-excerpt">
                {{ article.excerpt_or_content | strip_html | truncate: 160 }}
              </p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>
          {%- endif -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="blog__empty">{{ 'blogs.general.no_articles' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "t:sections.main_blog.name",
  "tag": "section",
  "class": "main-blog",
  "settings": []
}
{% endschema %}
