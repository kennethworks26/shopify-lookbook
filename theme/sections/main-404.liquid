{%- comment -%}
  Not found. Without this, a mistyped URL renders a template error rather than a
  page — which is exactly the kind of thing a reviewer stumbles into.
{%- endcomment -%}

<div class="not-found">
  <h1 class="not-found__title">{{ 'general.404.title' | t }}</h1>
  <p class="not-found__body">{{ 'general.404.body' | t }}</p>
  <a class="not-found__link" href="{{ routes.root_url }}">{{ 'general.404.link' | t }}</a>
</div>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "tag": "section",
  "class": "main-404",
  "settings": []
}
{% endschema %}
