{%- comment -%}
  Product information. Intentionally minimal: enough of a real product page for the
  lookbook section beneath it to be demonstrated in context, without reproducing a
  full commercial theme's variant picker, media gallery, and recommendation logic.

  Prices here come from Liquid's `money` filter, which already renders in the active
  market's currency. That is a useful contrast with the lookbook island: this section
  renders server-side in the market's currency, while the lookbook fetches the same
  market's prices at runtime through the Storefront API. Both agree, because both
  ultimately read the same market catalog.
{%- endcomment -%}

<div class="product">
  <div class="product__media">
    {%- if product.featured_media -%}
      <img
        src="{{ product.featured_media | image_url: width: 1200 }}"
        alt="{{ product.featured_media.alt | escape }}"
        width="{{ product.featured_media.width }}"
        height="{{ product.featured_media.height }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <div class="product__info">
    {%- if product.vendor != blank -%}
      <p class="product__vendor">{{ product.vendor }}</p>
    {%- endif -%}

    <h1 class="product__title">{{ product.title }}</h1>

    <div class="product__price">
      {%- if product.compare_at_price > product.price -%}
        <span class="product__price-sale">{{ product.price | money_with_currency }}</span>
        <s class="product__price-was">{{ product.compare_at_price | money_with_currency }}</s>
      {%- else -%}
        <span>{{ product.price | money_with_currency }}</span>
      {%- endif -%}
    </div>

    {%- form 'product', product -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button
        type="submit"
        class="product__submit"
        {% unless product.available %}
          disabled
        {% endunless %}
      >
        {%- if product.available -%}
          {{ 'products.product.add_to_cart' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </button>
    {%- endform -%}

    <div class="product__description rte">{{ product.description }}</div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "main-product",
  "settings": []
}
{% endschema %}
