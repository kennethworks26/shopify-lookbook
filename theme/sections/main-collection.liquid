{%- comment -%}
  Collection listing. Exists so the header's catalog link, and any collection URL,
  lands somewhere real rather than on a missing-template error.
{%- endcomment -%}

<div class="collection">
  <header class="collection__header">
    <h1 class="collection__title">{{ collection.title | default: 'Products' }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection__description rte">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by 24 -%}
    {%- if collection.products.size > 0 -%}
      <ul class="collection__grid">
        {%- for product in collection.products -%}
          <li>
            {%- if forloop.index <= 4 -%}
              {%- render 'card-product', product: product, loading: 'eager' -%}
            {%- else -%}
              {%- render 'card-product', product: product -%}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>
          {%- endif -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="collection__empty">{{ 'collections.general.no_products' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "tag": "section",
  "class": "main-collection",
  "settings": []
}
{% endschema %}
