<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}
      {% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}
      {% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>

    {%- comment -%}
      Fall back to the shop description, then to a sentence built from the shop
      name. `page_description` is empty on the home page unless a merchant fills
      it in, and a page with no description at all is a page search engines and
      link previews have to guess about.
    {%- endcomment -%}
    {%- liquid
      assign meta_description = page_description | default: shop.description
      if meta_description == blank
        assign meta_description = shop.name | append: ' — curated lookbooks and seasonal edits.'
      endif
    -%}
    <meta name="description" content="{{ meta_description | strip_html | escape }}">

    {%- comment -%}
      Favicon. An SVG served through asset_url so it is CDN-cached like every
      other asset — a data URI would inline it into every page and theme check
      flags it. A store with a real brand would replace this mark with its own.
    {%- endcomment -%}
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">

    {%- comment -%}
      Preconnect to the CDN that will serve product imagery. The lookbook fetches its
      products after hydration, so those image requests start late — warming the
      connection ahead of time removes a DNS and TLS round trip from the critical path.
    {%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {{ content_for_header }}

    {%- liquid
      assign body_font = settings.body_font
      assign heading_font = settings.heading_font
    -%}

    {% style %}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ heading_font | font_face: font_display: 'swap' }}

      /*
        Merchant settings are emitted as custom properties here rather than in
        base.css, because Liquid is not rendered inside .css files. Static fallbacks
        live in the stylesheet so the page is never unstyled if this block changes.
      */
      :root {
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --page-width: {{ settings.page_width }}px;
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'lookbook.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      Deferred, not async: the island reads DOM that Liquid emitted, so it must not
      run before the document is parsed. index.jsx also handles the case where
      DOMContentLoaded has already fired by the time the module evaluates.
    {%- endcomment -%}
    <script src="{{ 'lookbook.js' | asset_url }}" defer></script>
    <script src="{{ 'localization-form.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-to-content" href="#main-content">
      {{ 'general.accessibility.skip_to_content' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
